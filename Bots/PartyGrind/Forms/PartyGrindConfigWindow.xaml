<Window x:Class="CopilotBuddy.Bots.PartyGrind.Forms.PartyGrindConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Party Grind — Squad Configuration"
        Width="660" Height="640"
        Background="#FF2D2D30"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFDCDCDC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FF78C8FF"/>
            <Setter Property="BorderBrush" Value="#FF4E4E56"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#FF252528"/>
            <Setter Property="BorderBrush" Value="#FF4E4E56"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="Background" Value="#FF333337"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- TAB 1: SQUAD & ROLE -->
            <TabItem Header="Squad &amp; Role">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="Identity &amp; TCP IPC">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Team ID:"/>
                                <TextBox x:Name="TxtTeamId" Grid.Row="0" Grid.Column="1"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="IPC Loopback Port:"/>
                                <TextBox x:Name="TxtIpcPort" Grid.Row="1" Grid.Column="1"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="Squad Role:"/>
                                <ComboBox x:Name="CmbRole" Grid.Row="2" Grid.Column="1" SelectionChanged="CmbRole_SelectionChanged"/>

                                <CheckBox x:Name="ChkIsCoordinator" Grid.Row="3" Grid.Column="1"
                                          Content="Is Coordinator (hosts TCP server, leads route &amp; pulls)"/>

                                <Label Grid.Row="4" Grid.Column="0" Content="Coordinator Character Name:"/>
                                <TextBox x:Name="TxtCoordinatorName" Grid.Row="4" Grid.Column="1"/>

                                <Label Grid.Row="5" Grid.Column="0" Content="Expected Roster (CSV):"/>
                                <TextBox x:Name="TxtExpectedRoster" Grid.Row="5" Grid.Column="1"
                                         ToolTip="Comma-separated names of squad characters (3–5 clients)"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Group Invites &amp; Level Sync">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox x:Name="ChkAutoInvite" Grid.Row="0" Grid.ColumnSpan="2"
                                          Content="Coordinator auto-invites roster &amp; connected members"/>
                                <Label Grid.Row="1" Grid.Column="0" Content="Invite Interval (sec):"/>
                                <TextBox x:Name="TxtInviteInterval" Grid.Row="1" Grid.Column="1"/>

                                <CheckBox x:Name="ChkAutoAcceptInvite" Grid.Row="2" Grid.ColumnSpan="2"
                                          Content="Auto-accept party invite from Coordinator"/>
                                <CheckBox x:Name="ChkStrictWhitelist" Grid.Row="3" Grid.ColumnSpan="2"
                                          Content="Strict invite whitelist (decline strangers)"/>
                                <CheckBox x:Name="ChkAutoLoadProfile" Grid.Row="4" Grid.ColumnSpan="2"
                                          Content="Auto-load Coordinator profile XML on members"/>

                                <Label Grid.Row="5" Grid.Column="0" Content="Level Advance Mode:"/>
                                <ComboBox x:Name="CmbLevelAdvanceMode" Grid.Row="5" Grid.Column="1"/>

                                <Label Grid.Row="6" Grid.Column="0" Content="Disconnect Grace (sec):"/>
                                <TextBox x:Name="TxtDisconnectGrace" Grid.Row="6" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: COMBAT, FORMATION & REST -->
            <TabItem Header="Combat &amp; Formation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="Combat Roles &amp; Safety">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="DPS Engage Delay (ms):"/>
                                <TextBox x:Name="TxtDpsDelay" Grid.Row="0" Grid.Column="1"/>

                                <CheckBox x:Name="ChkHealerAssistDps" Grid.Row="1" Grid.ColumnSpan="2"
                                          Content="Healer casts safe ranged assist DPS when squad is healthy"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="Healer Assist Min Mana (%):"/>
                                <TextBox x:Name="TxtHealerAssistMana" Grid.Row="2" Grid.Column="1"/>

                                <CheckBox x:Name="ChkEmergencySelfHeal" Grid.Row="3" Grid.ColumnSpan="2"
                                          Content="Emergency self-heal (&lt; 35% HP) before healing allies"/>
                                <CheckBox x:Name="ChkForceTankAura" Grid.Row="4" Grid.ColumnSpan="2"
                                          Content="Force Tank defensive stance / form / aura / presence"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Formation &amp; Distance Hysteresis (yd)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Soft Wait Distance:"/>
                                <TextBox x:Name="TxtSoftWait" Grid.Row="0" Grid.Column="1"/>
                                <Label Grid.Row="1" Grid.Column="0" Content="Resume Distance:"/>
                                <TextBox x:Name="TxtResumeDist" Grid.Row="1" Grid.Column="1"/>
                                <Label Grid.Row="2" Grid.Column="0" Content="Hard Backtrack Distance:"/>
                                <TextBox x:Name="TxtHardBacktrack" Grid.Row="2" Grid.Column="1"/>
                                <Label Grid.Row="3" Grid.Column="0" Content="Max Pull Gather Distance:"/>
                                <TextBox x:Name="TxtMaxPullGather" Grid.Row="3" Grid.Column="1"/>
                                <Label Grid.Row="4" Grid.Column="0" Content="Ranged Standoff Distance:"/>
                                <TextBox x:Name="TxtRangedStandoff" Grid.Row="4" Grid.Column="1"/>
                                <Label Grid.Row="5" Grid.Column="0" Content="Healer Standoff Distance:"/>
                                <TextBox x:Name="TxtHealerStandoff" Grid.Row="5" Grid.Column="1"/>
                                <Label Grid.Row="6" Grid.Column="0" Content="Melee Flank Radius:"/>
                                <TextBox x:Name="TxtMeleeFlank" Grid.Row="6" Grid.Column="1"/>
                                <Label Grid.Row="7" Grid.Column="0" Content="Mount Policy:"/>
                                <ComboBox x:Name="CmbMountPolicy" Grid.Row="7" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Group Rest Hysteresis (%)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Trigger Rest HP %:"/>
                                <TextBox x:Name="TxtRestTriggerHp" Grid.Row="0" Grid.Column="1"/>
                                <Label Grid.Row="1" Grid.Column="0" Content="Trigger Rest Mana %:"/>
                                <TextBox x:Name="TxtRestTriggerMp" Grid.Row="1" Grid.Column="1"/>
                                <Label Grid.Row="2" Grid.Column="0" Content="Resume Fight HP %:"/>
                                <TextBox x:Name="TxtRestResumeHp" Grid.Row="2" Grid.Column="1"/>
                                <Label Grid.Row="3" Grid.Column="0" Content="Resume Fight Mana %:"/>
                                <TextBox x:Name="TxtRestResumeMp" Grid.Row="3" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: LOOT, TOWNRUN & PROVISIONING -->
            <TabItem Header="Loot, Town &amp; Provisioning">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="Loot &amp; Synchronized TownRun / Corpse">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Loot Method:"/>
                                <ComboBox x:Name="CmbLootMethod" Grid.Row="0" Grid.Column="1"/>
                                <Label Grid.Row="1" Grid.Column="0" Content="Group Roll Rule:"/>
                                <ComboBox x:Name="CmbRollRule" Grid.Row="1" Grid.Column="1"/>
                                <Label Grid.Row="2" Grid.Column="0" Content="Max Loot Window (sec):"/>
                                <TextBox x:Name="TxtMaxLootSec" Grid.Row="2" Grid.Column="1"/>
                                <CheckBox x:Name="ChkSyncTownRuns" Grid.Row="3" Grid.ColumnSpan="2"
                                          Content="Synchronize TownRuns across all clients"/>
                                <Label Grid.Row="4" Grid.Column="0" Content="Trigger Free Bag Slots &lt;=:"/>
                                <TextBox x:Name="TxtTownBagSlots" Grid.Row="4" Grid.Column="1"/>
                                <Label Grid.Row="5" Grid.Column="0" Content="Trigger Durability % &lt;=:"/>
                                <TextBox x:Name="TxtTownDurability" Grid.Row="5" Grid.Column="1"/>
                                <CheckBox x:Name="ChkTrainSkills" Grid.Row="6" Grid.ColumnSpan="2"
                                          Content="Visit individual Class Trainers during TownRun"/>
                                <Label Grid.Row="7" Grid.Column="0" Content="Wait for Party Ress (sec):"/>
                                <TextBox x:Name="TxtWaitRessSec" Grid.Row="7" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Mage Provisioning, Healthstones &amp; Party Buffs">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox x:Name="ChkEnableMageProv" Grid.Row="0" Grid.ColumnSpan="2"
                                          Content="Enable Mage food &amp; water provisioning"/>
                                <CheckBox x:Name="ChkPreferMageFood" Grid.Row="1" Grid.ColumnSpan="2"
                                          Content="Prefer Mage consumables over buying at vendor"/>
                                <Label Grid.Row="2" Grid.Column="0" Content="Min Member Food Stack:"/>
                                <TextBox x:Name="TxtMinFood" Grid.Row="2" Grid.Column="1"/>
                                <Label Grid.Row="3" Grid.Column="0" Content="Target Member Food Stack:"/>
                                <TextBox x:Name="TxtTargetFood" Grid.Row="3" Grid.Column="1"/>
                                <Label Grid.Row="4" Grid.Column="0" Content="Min Member Drink Stack:"/>
                                <TextBox x:Name="TxtMinDrink" Grid.Row="4" Grid.Column="1"/>
                                <Label Grid.Row="5" Grid.Column="0" Content="Target Member Drink Stack:"/>
                                <TextBox x:Name="TxtTargetDrink" Grid.Row="5" Grid.Column="1"/>
                                <Label Grid.Row="6" Grid.Column="0" Content="Trade Timeout (sec):"/>
                                <TextBox x:Name="TxtTradeTimeout" Grid.Row="6" Grid.Column="1"/>
                                <Label Grid.Row="7" Grid.Column="0" Content="Provision Cooldown (sec):"/>
                                <TextBox x:Name="TxtProvisionCooldown" Grid.Row="7" Grid.Column="1"/>
                                <CheckBox x:Name="ChkEnableWarlockHs" Grid.Row="8" Grid.ColumnSpan="2"
                                          Content="Enable Warlock Healthstones &amp; Soulstone on Healer"/>
                                <CheckBox x:Name="ChkUseRitualTables" Grid.Row="9" Grid.ColumnSpan="2"
                                          Content="Use Ritual of Refreshment / Soulwell when available"/>
                                <CheckBox x:Name="ChkEnableCrossBuffs" Grid.Row="10" Grid.ColumnSpan="2"
                                          Content="Enable out-of-combat cross-party buffs"/>
                                <CheckBox x:Name="ChkRaidMarkers" Grid.Row="11" Grid.ColumnSpan="2"
                                          Content="Coordinator sets Raid Target Markers (Skull/Square/Star)"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: MULTI-CLIENT LAUNCHER SCRIPT GENERATOR -->
            <TabItem Header="Launcher Script (3–5)">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="3–5 Client Batch Generator">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Client Count:"/>
                            <ComboBox x:Name="CmbClientCount" Grid.Row="0" Grid.Column="1" SelectionChanged="CmbClientCount_SelectionChanged"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Profile XML Path:"/>
                            <TextBox x:Name="TxtScriptProfilePath" Grid.Row="1" Grid.Column="1"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Character Names (CSV):"/>
                            <TextBox x:Name="TxtScriptNames" Grid.Row="2" Grid.Column="1"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="Roles (CSV):"/>
                            <TextBox x:Name="TxtScriptRoles" Grid.Row="3" Grid.Column="1"/>
                        </Grid>
                    </GroupBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4">
                        <Button x:Name="BtnGenerateScript" Content="Generate .bat Script" Click="BtnGenerateScript_Click" Background="#FF007ACC"/>
                        <Button x:Name="BtnCopyScript" Content="Copy Script" Click="BtnCopyScript_Click"/>
                    </StackPanel>

                    <TextBox x:Name="TxtGeneratedScript" Grid.Row="2"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"/>

                    <TextBlock Grid.Row="3" Margin="4"
                               Text="Each client uses -instance=Client1..N so StyxSettings.xml, UISettings.xml and ReloginSettings.xml stay isolated."/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnSave" Content="Save &amp; Close" Width="110" Background="#FF007ACC" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="90" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
