{"nodes": [{"id": "styx_logic_relogin_readme_auto_relogin_feature", "label": "Auto-Relogin Feature", "file_type": "concept", "source_file": "Styx/Logic/Relogin/README.md", "source_location": "L1-L9,L313-L321", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opt-in crash, hang, and disconnect recovery off by default; when disabled, creates no monitor thread, timer, polling, or memory probe."}, {"id": "styx_logic_relogin_readme_relogin_manager", "label": "ReloginManager", "file_type": "code", "source_file": "Styx/Logic/Relogin/README.md", "source_location": "L133-L145,L183-L201,L225-L267,L295", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "styx_logic_relogin_readme_relogin_client_probe", "label": "ReloginClient Memory Probe and Glue Lua Executor", "file_type": "code", "source_file": "Styx/Logic/Relogin/README.md", "source_location": "L45-L68,L232-L239,L296,L303-L306", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads GlueScreenString (0x00B6A9E0), g_ClientConnectionState (0x00BD0792), and IsLoadingOrConnecting (0x00B6AA38) via a short-lived read-only Win32 handle while unattached, invalidates DBC/cache pointers with StyxWoW.Reset(), and drives login glue via UTF-8 byte-escaped Lua."}, {"id": "styx_logic_relogin_readme_relogin_settings_vault", "label": "ReloginSettings and Windows Credential Manager Vault", "file_type": "concept", "source_file": "Styx/Logic/Relogin/README.md", "source_location": "L72-L127,L294", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores only PasswordReference in global Settings/ReloginSettings.xml while keeping credentials in the user-scoped Windows Credential Manager vault (migrating legacy plaintext entries on load) so exported settings never leak passwords."}, {"id": "styx_logic_relogin_readme_process_mutex_claim", "label": "Generation-Scoped ProcessMutex Recovery Claim", "file_type": "rationale", "source_file": "Styx/Logic/Relogin/README.md", "source_location": "L26-L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claims relaunched PIDs per recovery generation so a second CopilotBuddy cannot attach to the new client while retired runs cannot release active or newer mutex claims."}, {"id": "styx_logic_relogin_readme_detection_triggers_state", "label": "Crash, Hang, and Two-State Logout Detection", "file_type": "rationale", "source_file": "Styx/Logic/Relogin/README.md", "source_location": "L136-L180", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pairs worldDeparted (preserved across loading/unreadable polls while TreeRoot.IsRunning) with pendingLogout (reset on loading/unreadable polls, requiring 5s continuous login/charselect) so normal zoning or lag never false-triggers while logout through a loading screen still fires."}, {"id": "styx_logic_relogin_readme_wrong_password_classifier", "label": "Wrong-Password vs Unreachable-Server Classifier", "file_type": "rationale", "source_file": "Styx/Logic/Relogin/README.md", "source_location": "L203-L219", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because WoW 3.3.5a exposes no glue-error offset, classifies a login bounce as fatal credential rejection only when IsLoadingOrConnecting was never set after an actual DefaultServerLogin submission and return happened within LoginRejectSeconds with readable polls."}, {"id": "styx_logic_relogin_readme_resume_bot_lifecycle", "label": "In-World Confirmation and MainWindow Resume Lifecycle", "file_type": "rationale", "source_file": "Styx/Logic/Relogin/README.md", "source_location": "L249-L267,L307-L310", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifies in-world object walk and identity before reloading character settings/profile, re-pointing hotkeys, 